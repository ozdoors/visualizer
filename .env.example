# ---------------------------------------------------------------------------
# AI image engine — which provider generates the previews
# ---------------------------------------------------------------------------
# "gemini" (default, cheaper — ~$0.039/image) or "openai".
AI_PROVIDER=gemini

# --- Google Gemini (default) ---------------------------------------------
# Get a key at https://aistudio.google.com  → "Get API key".
GEMINI_API_KEY=
# Preferred image model for the railing edit (Step 5). Default is the fast,
# low-latency Lite model; the full "gemini-3.1-flash-image" is used
# automatically as a fallback if the Lite model is momentarily overloaded.
# Set this to gemini-3.1-flash-image if you prefer maximum quality first.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-lite-image
# Vision model for scene analysis (Step 4) + measurements (Step 6).
GEMINI_VISION_MODEL=gemini-3.5-flash

# --- OpenAI (only needed if AI_PROVIDER=openai) --------------------------
OPENAI_API_KEY=
# Current image model (gpt-image-1 retires Oct 2026); gpt-image-1-mini is cheaper.
OPENAI_IMAGE_MODEL=gpt-image-1.5
# Vision model for scene analysis + measurement estimation.
OPENAI_VISION_MODEL=gpt-4o
# low | medium | high | auto (OpenAI only).
OPENAI_IMAGE_QUALITY=high

# ---------------------------------------------------------------------------
# Email (Resend) — Step 7/8 quotation delivery
# ---------------------------------------------------------------------------
RESEND_API_KEY=re_...
# Must be on a domain you've verified in Resend.
EMAIL_FROM=visualizer@ozaluminiumrailing.ca
# Where quote requests + measurement estimates are sent. Internal only —
# never shown to the customer.
COMPANY_EMAIL=info@ozaluminiumrailing.ca

# ---------------------------------------------------------------------------
# Storage — Step 1 photo uploads + Step 5 generated images
# ---------------------------------------------------------------------------
# Create a Blob store in your Vercel project's Storage tab; it will inject
# this automatically when deployed on Vercel. Leave blank for local
# development (falls back to a local .data/uploads folder).
BLOB_READ_WRITE_TOKEN=

# ---------------------------------------------------------------------------
# Misc
# ---------------------------------------------------------------------------
NEXT_PUBLIC_MAX_UPLOAD_MB=20
# Public URL this app is deployed at (used to build local-storage file
# links; not needed once BLOB_READ_WRITE_TOKEN is set).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional shared secret to protect the internal /api/measurements route.
INTERNAL_API_SECRET=
